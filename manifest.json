{
  "schemaVersion": 1,
  "id": "io.github.erikwb.omakanvas",
  "name": "Omakanvas",
  "version": "1.1.0",
  "author": "Erik Bourget",
  "license": "MIT",
  "description": "Canvas bar widget supporting multiple login methods, persisting your course information so you can ask your agents about it, and more.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {"barWidget": "Panel.qml"},
  "barWidget": {
    "displayName": "Omakanvas",
    "description": "Student grades, teacher deadlines, and upcoming Canvas assignments.",
    "category": "Productivity",
    "aliases": ["canvas", "assignments", "school"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "baseUrl": "",
      "days": 14,
      "refreshIntervalSec": 3600
    },
    "schema": [
      {
        "key": "baseUrl",
        "type": "string",
        "label": "Canvas URL",
        "defaultValue": "",
        "description": "Your institution's Canvas origin, such as https://canvas.example.edu (without a course path)."
      },
      {
        "key": "days",
        "type": "integer",
        "label": "Upcoming assignment window (days)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 14
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 300,
        "max": 86400,
        "step": 900,
        "defaultValue": 3600
      }
    ]
  }
}
