class CrossOriginRequestError(RuntimeError):
    """Raised before an authenticated request can leave the Canvas origin."""


class CanvasAuthenticationError(RuntimeError):
    """Raised when Canvas rejects the configured credential."""


class CanvasPermissionError(RuntimeError):
    """Raised when a valid credential cannot access a Canvas resource."""


class BrowserSession(NamedTuple):
    base_url: str
    value: str


class CanvasCredential(NamedTuple):
    kind: str
    secret: str
    base_url: str


def _url_origin(url: str) -> tuple[str, str, int]:
    parsed = urlparse(url)
    if parsed.scheme.lower() != "https" or not parsed.hostname:
        raise CrossOriginRequestError("Canvas API requests must use HTTPS")
    if parsed.username is not None or parsed.password is not None:
        raise CrossOriginRequestError("Canvas API requests must not include URL credentials")
    try:
        port = parsed.port or 443
    except ValueError as error:
        raise CrossOriginRequestError("Canvas API request contains an invalid port") from error
    return parsed.scheme.lower(), parsed.hostname.lower(), port


def _require_same_origin(base_url: str, candidate_url: str) -> str:
    if _url_origin(base_url) != _url_origin(candidate_url):
        raise CrossOriginRequestError(
            "Canvas returned a redirect or pagination link outside the configured origin"
        )
    return candidate_url


class SameOriginRedirectHandler(HTTPRedirectHandler):
    def __init__(self, base_url: str):
        super().__init__()
        self.base_url = base_url

    def redirect_request(self, request, fp, code, message, headers, new_url):
        target = urljoin(request.full_url, new_url)
        _require_same_origin(self.base_url, target)
        return super().redirect_request(request, fp, code, message, headers, target)


def visibility_path() -> Path:
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return config_home / "omakanvas" / "hidden-courses.json"


def shell_config_path() -> Path:
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return config_home / "omarchy" / "shell.json"


def configured_canvas_base_url(path: Path | None = None) -> str | None:
    path = path or shell_config_path()
    if not path.exists():
        return None
    try:
        if path.stat().st_size > 2 * 1024 * 1024:
            raise RuntimeError("Omarchy shell configuration exceeded the size limit")
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"Could not read Omarchy's shell configuration: {error}") from error
    if not isinstance(data, dict):
        return None
    bar = data.get("bar")
    layout = bar.get("layout") if isinstance(bar, dict) else None
    if not isinstance(layout, dict):
        return None
    for section in ("left", "center", "right"):
        widgets = layout.get(section)
        if not isinstance(widgets, list):
            continue
        for widget in widgets:
            if not isinstance(widget, dict) or widget.get("id") != PLUGIN_ID:
                continue
            value = widget.get("baseUrl")
            if isinstance(value, str) and value.strip():
                return normalize_instance_url(value)
    return None


def resolve_base_url(value: str = "", config_path: Path | None = None) -> str:
    explicit = value or os.environ.get("CANVAS_BASE_URL", "")
    if explicit:
        return normalize_instance_url(explicit)
    configured = configured_canvas_base_url(config_path)
    if configured:
        return configured
    raise RuntimeError(
        "No Canvas URL was provided and Omakanvas has no configured baseUrl. "
        f"Set it with 'omarchy bar set {PLUGIN_ID} baseUrl https://canvas.example.edu' "
        "or pass --base-url"
    )


def normalize_instance_url(base_url: str) -> str:
    value = base_url.strip().rstrip("/")
    parsed = urlparse(value)
    if parsed.scheme.lower() != "https" or not parsed.netloc:
        raise RuntimeError(
            "Canvas URL must include https:// and a hostname "
            "(for example, https://canvas.example.edu)"
        )
    if parsed.username is not None or parsed.password is not None:
        raise RuntimeError("Canvas URL must not include a username or password")
    try:
        port = parsed.port
    except ValueError as error:
        raise RuntimeError("Canvas URL contains an invalid port") from error
    if parsed.path not in {"", "/"}:
        raise RuntimeError("Canvas URL must not include a path")
    if parsed.query or parsed.fragment:
        raise RuntimeError("Canvas URL must not include a query string or fragment")
    hostname = parsed.hostname
    if not hostname:
        raise RuntimeError("Canvas URL must include a hostname")
    try:
        hostname = hostname.encode("idna").decode("ascii").lower()
    except UnicodeError as error:
        raise RuntimeError("Canvas URL contains an invalid hostname") from error
    if ":" in hostname:
        hostname = f"[{hostname}]"
    netloc = hostname if port is None else f"{hostname}:{port}"
    return f"https://{netloc}"


def sanitize_text(value: Any, fallback: str = "") -> str:
    text = unescape(str(value if value is not None else fallback))
    text = "".join(
        " " if unicodedata.category(character) in {"Cc", "Cf"} else character
        for character in text
    )
    return " ".join(text.split()) or fallback


def validated_canvas_web_url(base_url: str, value: Any) -> str | None:
    if not isinstance(value, str) or not value.strip():
        return None
    if any(unicodedata.category(character) == "Cc" for character in value):
        return None
    candidate = urljoin(normalize_instance_url(base_url) + "/", value.strip())
    try:
        return _require_same_origin(base_url, candidate)
    except CrossOriginRequestError:
        return None


def canvas_course_web_url(base_url: str, course_id: Any) -> str | None:
    if isinstance(course_id, bool):
        return None
    course_key = str(course_id).strip()
    if not re.fullmatch(r"[0-9]+", course_key):
        return None
    return validated_canvas_web_url(base_url, f"/courses/{course_key}")


def _load_visibility(path: Path | None = None) -> dict[str, Any]:
    path = path or visibility_path()
    if path.is_symlink():
        raise RuntimeError("Hidden-course preferences must not be a symbolic link")
    if not path.exists():
        return {"version": VISIBILITY_VERSION, "instances": {}}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"Could not read hidden-course preferences: {error}") from error
    if not isinstance(data, dict) or data.get("version") != VISIBILITY_VERSION:
        raise RuntimeError("Hidden-course preferences use an unsupported format")
    if not isinstance(data.get("instances"), dict):
        data["instances"] = {}
    return data


def hidden_courses_for(base_url: str, path: Path | None = None) -> dict[str, dict[str, str]]:
    data = _load_visibility(path)
    courses = data["instances"].get(normalize_instance_url(base_url), {})
    return courses if isinstance(courses, dict) else {}


def set_course_hidden(
    base_url: str,
    course_id: str,
    hidden: bool,
    name: str = "",
    code: str = "",
    path: Path | None = None,
) -> None:
    path = path or visibility_path()
    data = _load_visibility(path)
    instance_url = normalize_instance_url(base_url)
    instances = data["instances"]
    courses = instances.setdefault(instance_url, {})
    course_key = str(course_id)
    if hidden:
        courses[course_key] = {"name": name, "code": code}
    else:
        courses.pop(course_key, None)
        if not courses:
            instances.pop(instance_url, None)
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path.parent, 0o700)
    serialized = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", suffix=".tmp", dir=path.parent,
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            output.write(serialized)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def _keyring_token(base_url: str) -> str | None:
    secret_tool = secret_tool_path()
    if not secret_tool:
        return None
    instance_url = normalize_instance_url(base_url)
    try:
        result = subprocess.run(
            [secret_tool, "lookup", "service", SERVICE, "base_url", instance_url],
            check=False, capture_output=True, text=True, timeout=5,
        )
        token = result.stdout.strip()
        return token or None
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError(f"Could not read the Canvas token from the system keyring: {error}") from error


def get_token(base_url: str, token_from_environment: bool = False) -> str | None:
    if token_from_environment:
        return os.environ.get("CANVAS_API_KEY", "").strip() or None
    return _keyring_token(base_url)


def save_token(base_url: str, token: str) -> None:
    secret_tool = secret_tool_path()
    if not secret_tool:
        raise RuntimeError("secret-tool is required to save a token; install libsecret")
    instance_url = normalize_instance_url(base_url)
    token = token.strip()
    if not token:
        raise RuntimeError("Canvas API token cannot be empty")
    hostname = urlparse(instance_url).netloc
    try:
        subprocess.run(
            [secret_tool, "store", f"--label=Omakanvas API token ({hostname})",
             "service", SERVICE, "base_url", instance_url],
            input=token + "\n", text=True, check=True,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError(f"Could not save the Canvas token in the system keyring: {error}") from error


def clear_token(base_url: str) -> None:
    secret_tool = secret_tool_path()
    if not secret_tool:
        raise RuntimeError("secret-tool is required to remove a saved token")
    instance_url = normalize_instance_url(base_url)
    try:
        subprocess.run(
            [secret_tool, "clear", "service", SERVICE, "base_url", instance_url],
            check=True, capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError(f"Could not remove the Canvas token from the system keyring: {error}") from error


def _validate_browser_session(value: str) -> str:
    session = value.strip()
    if (
        not session
        or len(session) > 16_384
        or ";" in session
        or any(ord(character) < 0x20 or ord(character) == 0x7f for character in session)
    ):
        raise RuntimeError("The saved Canvas browser session is invalid")
    return session


def _decode_browser_session(value: str, fallback_base_url: str) -> BrowserSession:
    try:
        record = json.loads(value)
    except json.JSONDecodeError:
        record = None
    if isinstance(record, dict):
        if record.get("version") != BROWSER_SESSION_VERSION:
            raise RuntimeError("The saved Canvas browser session uses an unsupported format")
        stored_base_url = record.get("base_url")
        stored_session = record.get("canvas_session")
        if not isinstance(stored_base_url, str) or not isinstance(stored_session, str):
            raise RuntimeError("The saved Canvas browser session is invalid")
        return BrowserSession(
            normalize_instance_url(stored_base_url),
            _validate_browser_session(stored_session),
        )
    return BrowserSession(
        normalize_instance_url(fallback_base_url),
        _validate_browser_session(value),
    )


def _keyring_browser_session(base_url: str) -> BrowserSession | None:
    secret_tool = secret_tool_path()
    if not secret_tool:
        return None
    instance_url = normalize_instance_url(base_url)
    try:
        result = subprocess.run(
            [secret_tool, "lookup", "service", BROWSER_SESSION_SERVICE,
             "base_url", instance_url],
            check=False, capture_output=True, text=True, timeout=5,
        )
        session = result.stdout.strip()
        return _decode_browser_session(session, instance_url) if session else None
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError(
            f"Could not read the Canvas browser session from the system keyring: {error}"
        ) from error


def save_browser_session(
    base_url: str,
    session: str,
    session_base_url: str | None = None,
) -> None:
    secret_tool = secret_tool_path()
    if not secret_tool:
        raise RuntimeError("secret-tool is required to save a browser session; install libsecret")
    instance_url = normalize_instance_url(base_url)
    session = _validate_browser_session(session)
    effective_base_url = normalize_instance_url(session_base_url or instance_url)
    hostname = urlparse(effective_base_url).netloc
    stored_session = json.dumps({
        "version": BROWSER_SESSION_VERSION,
        "base_url": effective_base_url,
        "canvas_session": session,
    }, separators=(",", ":"), sort_keys=True)
    try:
        subprocess.run(
            [secret_tool, "store", f"--label=Omakanvas browser session ({hostname})",
             "service", BROWSER_SESSION_SERVICE, "base_url", instance_url],
            input=stored_session + "\n", text=True, check=True,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError(
            f"Could not save the Canvas browser session in the system keyring: {error}"
        ) from error


def clear_browser_session(base_url: str) -> None:
    secret_tool = secret_tool_path()
    if not secret_tool:
        raise RuntimeError("secret-tool is required to remove a saved browser session")
    instance_url = normalize_instance_url(base_url)
    try:
        subprocess.run(
            [secret_tool, "clear", "service", BROWSER_SESSION_SERVICE,
             "base_url", instance_url],
            check=True, capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError(
            f"Could not remove the Canvas browser session from the system keyring: {error}"
        ) from error


def get_credential(
    base_url: str,
    token_from_environment: bool = False,
) -> CanvasCredential | None:
    instance_url = normalize_instance_url(base_url)
    if token_from_environment:
        token = get_token(base_url, token_from_environment=True)
        return CanvasCredential("token", token, instance_url) if token else None
    session = _keyring_browser_session(base_url)
    if session:
        return CanvasCredential("browser_session", session.value, session.base_url)
    token = get_token(base_url)
    return CanvasCredential("token", token, instance_url) if token else None


def secret_tool_path() -> str | None:
    located = shutil.which("secret-tool")
    return str(Path(located).resolve()) if located else None


def browser_path(requested: str = "") -> str:
    if requested:
        located = shutil.which(requested)
        if not located and os.path.sep in requested:
            candidate = Path(requested).expanduser()
            if candidate.is_file() and os.access(candidate, os.X_OK):
                located = str(candidate)
        if not located:
            raise RuntimeError(f"Could not find the requested browser: {requested}")
        return str(Path(located).resolve())
    for candidate in BROWSER_CANDIDATES:
        located = shutil.which(candidate)
        if located:
            return str(Path(located).resolve())
    raise RuntimeError(
        "Browser login requires Chromium, Chrome, Brave, Edge, or Vivaldi; "
        "install one or pass --browser"
    )


class DevToolsPipe:
    """Minimal client for Chromium's process-private DevTools pipe."""

    def __init__(self, read_fd: int, write_fd: int):
        self.read_fd = read_fd
        self.write_fd = write_fd
        self.buffer = b""
        self.next_id = 1

    def _send_message(self, payload: bytes) -> None:
        if len(payload) > MAX_DEVTOOLS_MESSAGE_BYTES:
            raise RuntimeError("DevTools message exceeded the size limit")
        data = payload + b"\0"
        while data:
            written = os.write(self.write_fd, data)
            if written <= 0:
                raise RuntimeError("Browser closed the DevTools connection")
            data = data[written:]

    def _receive_message(self) -> str:
        deadline = time.monotonic() + 15
        while b"\0" not in self.buffer:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise RuntimeError("Browser did not respond to the DevTools request")
            ready, _writeable, _exceptional = select.select(
                [self.read_fd], [], [], remaining,
            )
            if not ready:
                raise RuntimeError("Browser did not respond to the DevTools request")
            chunk = os.read(self.read_fd, 64 * 1024)
            if not chunk:
                raise RuntimeError("Browser closed the DevTools connection")
            self.buffer += chunk
            if len(self.buffer) > MAX_DEVTOOLS_MESSAGE_BYTES:
                raise RuntimeError("DevTools message exceeded the size limit")
        payload, self.buffer = self.buffer.split(b"\0", 1)
        try:
            return payload.decode("utf-8")
        except UnicodeDecodeError as error:
            raise RuntimeError("Browser returned invalid DevTools data") from error

    def command(
        self,
        method: str,
        params: dict[str, Any] | None = None,
        session_id: str | None = None,
    ) -> dict[str, Any]:
        command_id = self.next_id
        self.next_id += 1
        message: dict[str, Any] = {"id": command_id, "method": method}
        if params is not None:
            message["params"] = params
        if session_id is not None:
            message["sessionId"] = session_id
        self._send_message(json.dumps(message, separators=(",", ":")).encode("utf-8"))
        while True:
            try:
                response = json.loads(self._receive_message())
            except json.JSONDecodeError as error:
                raise RuntimeError("Browser returned invalid DevTools JSON") from error
            if not isinstance(response, dict) or response.get("id") != command_id:
                continue
            if "error" in response:
                raise RuntimeError("Browser could not provide its Canvas session")
            result = response.get("result", {})
            if not isinstance(result, dict):
                raise RuntimeError("Browser returned an invalid DevTools result")
            return result

    def close(self) -> None:
        for attribute in ("write_fd", "read_fd"):
            descriptor = getattr(self, attribute, -1)
            if descriptor >= 0:
                try:
                    os.close(descriptor)
                except OSError:
                    pass
                setattr(self, attribute, -1)

    def __enter__(self):
        return self

    def __exit__(self, *_args):
        self.close()


def _start_browser(
    executable: str,
    profile: Path,
    instance_url: str,
) -> tuple[subprocess.Popen, DevToolsPipe]:
    command_read, parent_write = os.pipe()
    parent_read, command_write = os.pipe()

    def configure_devtools_pipe() -> None:
        os.dup2(command_read, 3)
        os.dup2(command_write, 4)
        if command_read not in {3, 4}:
            os.close(command_read)
        if command_write not in {3, 4}:
            os.close(command_write)

    descriptors = {command_read, parent_write, parent_read, command_write}
    try:
        process = subprocess.Popen(
            [
                executable,
                f"--user-data-dir={profile}",
                "--remote-debugging-pipe",
                "--no-first-run",
                "--no-default-browser-check",
                "--new-window",
                f"{instance_url}/login",
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            pass_fds=tuple({command_read, command_write, 3, 4}),
            preexec_fn=configure_devtools_pipe,
        )
    except BaseException:
        for descriptor in descriptors:
            try:
                os.close(descriptor)
            except OSError:
                pass
        raise
    os.close(command_read)
    os.close(command_write)
    return process, DevToolsPipe(parent_read, parent_write)


def _browser_target_origins(targets: Any, initial_base_url: str) -> list[str]:
    origins = [normalize_instance_url(initial_base_url)]
    if not isinstance(targets, list):
        return origins
    for target in targets:
        if not isinstance(target, dict) or target.get("type") != "page":
            continue
        value = target.get("url")
        if not isinstance(value, str):
            continue
        parsed = urlparse(value)
        if parsed.scheme.lower() != "https" or not parsed.netloc:
            continue
        try:
            origin = normalize_instance_url(f"https://{parsed.netloc}")
        except RuntimeError:
            continue
        if origin not in origins:
            origins.append(origin)
    return origins


def _canvas_session_from_cookies(
    cookies: Any,
    base_url: str,
    now: float | None = None,
) -> str | None:
    if not isinstance(cookies, list):
        return None
    host = urlparse(normalize_instance_url(base_url)).hostname
    if not host:
        return None
    now = time.time() if now is None else now
    matches = []
    for cookie in cookies:
        if not isinstance(cookie, dict) or cookie.get("name") != "canvas_session":
            continue
        domain = str(cookie.get("domain", "")).lstrip(".").lower()
        path = str(cookie.get("path", "/"))
        expires = cookie.get("expires", -1)
        domain_matches = host == domain or host.endswith(f".{domain}")
        path_matches = path == "/" or "/api/v1/users/self".startswith(path.rstrip("/") + "/")
        if (
            not domain
            or not domain_matches
            or not path_matches
            or cookie.get("secure") is not True
            or isinstance(expires, (int, float)) and expires > 0 and expires <= now
        ):
            continue
        try:
            value = _validate_browser_session(str(cookie.get("value", "")))
        except RuntimeError:
            continue
        matches.append((host == domain, len(domain), len(path), value))
    if not matches:
        return None
    matches.sort(reverse=True)
    return matches[0][3]


def _browser_session_is_authenticated(base_url: str, session: str) -> bool:
    try:
        user = CanvasClient(base_url, browser_session=session).get_object("api/v1/users/self")
    except RuntimeError:
        return False
    user_id = user.get("id")
    return isinstance(user_id, (int, str)) and not isinstance(user_id, bool) and str(user_id) != ""


def _stop_browser(process: subprocess.Popen) -> None:
    if process.poll() is not None:
        return
    process.terminate()
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait(timeout=5)


def _cancel_browser_login(_signum: int, _frame: Any) -> None:
    raise RuntimeError("Canvas browser login was cancelled")


def browser_login(
    base_url: str,
    requested_browser: str = "",
    timeout: int = DEFAULT_LOGIN_TIMEOUT_SECONDS,
) -> BrowserSession:
    if not 30 <= timeout <= 900:
        raise RuntimeError("Browser login timeout must be between 30 and 900 seconds")
    instance_url = normalize_instance_url(base_url)
    executable = browser_path(requested_browser)
    deadline = time.monotonic() + timeout
    with tempfile.TemporaryDirectory(prefix="omakanvas-browser-") as directory:
        profile = Path(directory)
        os.chmod(profile, 0o700)
        process, connection = _start_browser(executable, profile, instance_url)
        previous_sigterm = signal.signal(signal.SIGTERM, _cancel_browser_login)
        try:
            last_validations: dict[str, tuple[str, float]] = {}
            with connection:
                targets = connection.command("Target.getTargets").get("targetInfos", [])
                target_id = next(
                    (
                        target.get("targetId") for target in targets
                        if isinstance(target, dict) and target.get("type") == "page"
                    ),
                    None,
                )
                if not isinstance(target_id, str) or not target_id:
                    raise RuntimeError("Browser did not create a Canvas login page")
                attached = connection.command(
                    "Target.attachToTarget", {"targetId": target_id, "flatten": True},
                )
                session_id = attached.get("sessionId")
                if not isinstance(session_id, str) or not session_id:
                    raise RuntimeError("Browser could not inspect the Canvas login page")
                while time.monotonic() < deadline:
                    if process.poll() is not None:
                        raise RuntimeError("The browser closed before Canvas login completed")
                    target_infos = connection.command(
                        "Target.getTargets"
                    ).get("targetInfos", [])
                    for candidate_base_url in _browser_target_origins(
                        target_infos, instance_url,
                    ):
                        result = connection.command(
                            "Network.getCookies",
                            {"urls": [candidate_base_url]},
                            session_id,
                        )
                        candidate = _canvas_session_from_cookies(
                            result.get("cookies"), candidate_base_url,
                        )
                        if not candidate:
                            continue
                        current_time = time.monotonic()
                        previous = last_validations.get(candidate_base_url)
                        if previous and candidate == previous[0] and current_time - previous[1] < 2:
                            continue
                        last_validations[candidate_base_url] = candidate, current_time
                        if _browser_session_is_authenticated(candidate_base_url, candidate):
                            return BrowserSession(candidate_base_url, candidate)
                    time.sleep(0.5)
            raise RuntimeError("Canvas browser login timed out")
        finally:
            signal.signal(signal.SIGTERM, previous_sigterm)
            connection.close()
            _stop_browser(process)


class CanvasClient:
    def __init__(
        self,
        base_url: str,
        token: str | None = None,
        opener=None,
        clock=None,
        *,
        browser_session: str | None = None,
        login_base_url: str | None = None,
    ):
        if bool(token) == bool(browser_session):
            raise RuntimeError("Exactly one Canvas credential is required")
        self.base_url = normalize_instance_url(base_url) + "/"
        self.login_base_url = normalize_instance_url(login_base_url or base_url)
        if browser_session:
            self.auth_kind = "browser_session"
            self.auth_headers = {
                "Cookie": f"canvas_session={_validate_browser_session(browser_session)}",
            }
        else:
            self.auth_kind = "token"
            self.auth_headers = {"Authorization": f"Bearer {token}"}
        self.opener = opener or build_opener(SameOriginRedirectHandler(self.base_url))
        self.clock = clock or time.monotonic
        self.deadline = self.clock() + MAX_FETCH_SECONDS

    def _request_timeout(self) -> float:
        remaining = self.deadline - self.clock()
        if remaining <= 0:
            raise RuntimeError("Canvas refresh exceeded the allowed duration")
        return min(REQUEST_TIMEOUT_SECONDS, remaining)

    def _authentication_error(self) -> CanvasAuthenticationError:
        if self.auth_kind == "browser_session":
            return CanvasAuthenticationError(
                "Canvas rejected the browser session; run "
                f"'omakanvas login --base-url {self.login_base_url}' again"
            )
        return CanvasAuthenticationError("Canvas rejected the API token")

    def _get_json(self, url: str) -> tuple[Any, Any]:
        _require_same_origin(self.base_url, url)
        headers = {"Accept": "application/json", **self.auth_headers}
        request = Request(url, headers=headers)
        try:
            with self.opener.open(request, timeout=self._request_timeout()) as response:
                raw = response.read(MAX_RESPONSE_BYTES + 1)
                if len(raw) > MAX_RESPONSE_BYTES:
                    raise RuntimeError("Canvas API response exceeded the size limit")
                try:
                    payload = json.loads(raw.decode("utf-8"))
                except json.JSONDecodeError as error:
                    if self.auth_kind == "browser_session":
                        raise self._authentication_error() from error
                    raise RuntimeError("Canvas API returned invalid JSON") from error
                return payload, response.headers
        except HTTPError as error:
            if error.code == 401:
                raise self._authentication_error() from error
            if error.code == 403:
                raise CanvasPermissionError(
                    "Canvas denied access to data for this role"
                ) from error
            raise RuntimeError(f"Canvas API returned HTTP {error.code}") from error
        except (URLError, TimeoutError, UnicodeDecodeError) as error:
            raise RuntimeError(f"Could not reach Canvas: {error}") from error

    def get_object(self, path: str) -> dict[str, Any]:
        url = urljoin(self.base_url, path.lstrip("/"))
        payload, _headers = self._get_json(url)
        if not isinstance(payload, dict):
            raise RuntimeError("Canvas API returned an unexpected response format")
        return payload

    def get_all(self, path: str, params: dict[str, Any] | None = None) -> list[dict[str, Any]]:
        url = urljoin(self.base_url, path.lstrip("/"))
        if params:
            url += "?" + urlencode(params, doseq=True)
        records: list[dict[str, Any]] = []
        visited: set[str] = set()
        while url:
            _require_same_origin(self.base_url, url)
            if url in visited:
                raise RuntimeError("Canvas pagination repeated a page")
            if len(visited) >= MAX_PAGES:
                raise RuntimeError("Canvas pagination exceeded the page limit")
            visited.add(url)
            page, headers = self._get_json(url)
            if not isinstance(page, list) or not all(isinstance(item, dict) for item in page):
                raise RuntimeError("Canvas API returned an unexpected response format")
            if len(records) + len(page) > MAX_RECORDS:
                raise RuntimeError("Canvas API response exceeded the record limit")
            records.extend(page)
            next_link = _next_link(headers.get("Link"))
            url = _require_same_origin(self.base_url, urljoin(url, next_link)) if next_link else None
        return records


def _next_link(header: str | None) -> str | None:
    if not header:
        return None
    for part in header.split(","):
        match = re.match(r"\s*<([^>]+)>\s*;\s*rel=\"?next\"?", part)
        if match:
            return match.group(1)
    return None


def parse_time(value: Any) -> datetime | None:
    if not isinstance(value, str) or not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(timezone.utc)
    except (TypeError, ValueError):
        return None


def iso_time(value: Any) -> str | None:
    parsed = parse_time(value)
    return parsed.isoformat() if parsed is not None else None


def assignment_schedules(
    assignment: dict[str, Any],
    now: datetime,
    cutoff: datetime,
    include_all_dates: bool,
) -> list[dict[str, Any]]:
    date_records: list[dict[str, Any]] = []
    if include_all_dates and isinstance(assignment.get("all_dates"), list):
        date_records = [
            item for item in assignment["all_dates"] if isinstance(item, dict)
        ]
    if not any(parse_time(item.get("due_at")) for item in date_records):
        date_records = [assignment]

    schedules = []
    seen = set()
    for item in date_records:
        due = parse_time(item.get("due_at"))
        if due is None or not now <= due <= cutoff:
            continue
        schedule = {
            "due_at": due.isoformat(),
            "unlock_at": iso_time(item.get("unlock_at")),
            "lock_at": iso_time(item.get("lock_at")),
            "title": sanitize_text(item.get("title")) or None,
        }
        key = tuple(schedule.values())
        if key not in seen:
            schedules.append(schedule)
            seen.add(key)
    schedules.sort(key=lambda item: (
        item["due_at"], item["unlock_at"] or "", item["title"] or "",
    ))
    return schedules


def plain_text_excerpt(value: Any, limit: int = ANNOUNCEMENT_EXCERPT_LENGTH) -> str:
    text = sanitize_text(re.sub(r"<[^<>]*>", " ", str(value or "")))
    if len(text) > limit:
        text = text[: max(0, limit - 1)].rstrip() + "…"
    return text


def collect_announcements(
    client: CanvasClient,
    course_id: Any,
) -> list[dict[str, Any]]:
    """Return every announcement for a course, newest first.

    The full list is kept in the payload so external tools can process it;
    the panel displays only a recent subset.
    """
    try:
        topics = client.get_all(
            f"api/v1/courses/{course_id}/discussion_topics",
            {"only_announcements": "true", "per_page": 100},
        )
    except CanvasPermissionError:
        return []
    scored: list[tuple[datetime, dict[str, Any]]] = []
    for topic in topics:
        if not isinstance(topic, dict):
            continue
        posted = parse_time(topic.get("posted_at")) or parse_time(topic.get("created_at"))
        author = topic.get("author")
        author_name = sanitize_text(
            author.get("display_name") if isinstance(author, dict) else None
        )
        scored.append((
            posted or datetime.min.replace(tzinfo=timezone.utc),
            {
                "id": topic.get("id"),
                "title": sanitize_text(topic.get("title"), "Untitled announcement"),
                "posted_at": posted.isoformat() if posted is not None else None,
                "author": author_name or None,
                "excerpt": plain_text_excerpt(topic.get("message")),
                "html_url": validated_canvas_web_url(
                    client.base_url, topic.get("html_url"),
                ),
            },
        ))
    scored.sort(key=lambda item: item[0], reverse=True)
    return [item for _, item in scored]


def collect_discussions(
    client: CanvasClient,
    course_id: Any,
) -> list[dict[str, Any]]:
    """Return every discussion topic for a course, most active first.

    Announcements are excluded by the API when only_announcements is absent.
    The full list is kept in the payload so external tools can process it;
    the panel displays only a recent subset.
    """
    try:
        topics = client.get_all(
            f"api/v1/courses/{course_id}/discussion_topics",
            {"order_by": "recent_activity", "per_page": 100},
        )
    except CanvasPermissionError:
        return []
    scored: list[tuple[datetime, dict[str, Any]]] = []
    for topic in topics:
        if not isinstance(topic, dict):
            continue
        activity = (
            parse_time(topic.get("last_reply_at"))
            or parse_time(topic.get("posted_at"))
            or parse_time(topic.get("created_at"))
        )
        posted = parse_time(topic.get("posted_at")) or parse_time(topic.get("created_at"))
        author = topic.get("author")
        if isinstance(author, dict):
            author_name = sanitize_text(author.get("display_name"))
        else:
            author_name = sanitize_text(topic.get("user_name"))
        reply_count = topic.get("discussion_subentry_count")
        if not isinstance(reply_count, int) or isinstance(reply_count, bool):
            reply_count = 0
        scored.append((
            activity or datetime.min.replace(tzinfo=timezone.utc),
            {
                "id": topic.get("id"),
                "title": sanitize_text(topic.get("title"), "Untitled discussion"),
                "posted_at": posted.isoformat() if posted is not None else None,
                "last_activity_at": activity.isoformat() if activity is not None else None,
                "author": author_name or None,
                "reply_count": reply_count,
                "pinned": topic.get("pinned") is True,
                "locked": topic.get("locked") is True,
                "excerpt": plain_text_excerpt(topic.get("message")),
                "html_url": validated_canvas_web_url(
                    client.base_url, topic.get("html_url"),
                ),
            },
        ))
    scored.sort(key=lambda item: item[0], reverse=True)
    return [item for _, item in scored]


def collect_conversations(
    client: CanvasClient,
    course_id: Any,
) -> list[dict[str, Any]]:
    """Return every conversation for a course, newest first.

    The full list is kept in the payload so external tools can process it;
    the panel displays only unread conversations.
    """
    try:
        records = client.get_all(
            "api/v1/conversations",
            {"filter": f"course_{course_id}", "per_page": 100},
        )
    except CanvasPermissionError:
        return []
    inbox_url = validated_canvas_web_url(client.base_url, "/conversations")
    scored: list[tuple[datetime, dict[str, Any]]] = []
    for record in records:
        if not isinstance(record, dict):
            continue
        sent_at = parse_time(record.get("last_message_at"))
        participants: list[dict[str, Any]] = []
        seen_participants = set()
        for participant in record.get("participants") or []:
            if not isinstance(participant, dict) or participant.get("id") in seen_participants:
                continue
            seen_participants.add(participant.get("id"))
            participants.append({
                "id": participant.get("id"),
                "name": sanitize_text(participant.get("name"), "Unknown"),
            })
            if len(participants) >= MAX_CONVERSATION_PARTICIPANTS:
                break
        message_count = record.get("message_count")
        if not isinstance(message_count, int) or isinstance(message_count, bool):
            message_count = 0
        scored.append((
            sent_at or datetime.min.replace(tzinfo=timezone.utc),
            {
                "id": record.get("id"),
                "subject": sanitize_text(record.get("subject"), "No subject"),
                "workflow_state": record.get("workflow_state"),
                "unread": record.get("workflow_state") == "unread",
                "last_message_at": sent_at.isoformat() if sent_at is not None else None,
                "last_message": plain_text_excerpt(record.get("last_message")),
                "message_count": message_count,
                "starred": record.get("starred") is True,
                "participants": participants,
                "context_name": sanitize_text(record.get("context_name")) or None,
                "html_url": inbox_url,
            },
        ))
    scored.sort(key=lambda item: item[0], reverse=True)
    return [item for _, item in scored]


def empty_role_payload(error: str = "") -> dict[str, Any]:
    return {
        "available": False,
        "error": error,
        "courses": [],
        "hidden_courses": [],
    }


def collect_role(
    client: CanvasClient,
    role: str,
    days: int = 14,
    now: datetime | None = None,
    hidden_course_ids: set[str] | None = None,
) -> dict[str, Any]:
    if role not in {"student", "teacher"}:
        raise ValueError(f"Unsupported Canvas role: {role}")
    now = now or datetime.now(timezone.utc)
    cutoff = now + timedelta(days=days)
    hidden_course_ids = hidden_course_ids or set()
    include = "total_scores" if role == "student" else "needs_grading_count"
    courses = client.get_all("api/v1/courses", {
        "enrollment_state": "active", "enrollment_type": role,
        "include[]": [include], "per_page": 100,
    })
    result_courses = []
    hidden_courses = []
    enrollment_types = {
        "student": {"student", "studentenrollment"},
        "teacher": {"teacher", "teacherenrollment"},
    }[role]
    for course in courses:
        if not course.get("id") or course.get("access_restricted_by_date"):
            continue
        enrollments = course.get("enrollments") or []
        enrollment = next(
            (item for item in enrollments
             if str(item.get("type", "")).lower() in enrollment_types),
            None,
        )
        if enrollments and enrollment is None:
            continue
        course_name = sanitize_text(course.get("name"), "Unnamed course")
        course_code = sanitize_text(course.get("course_code"))
        if str(course["id"]) in hidden_course_ids:
            hidden_courses.append({
                "id": course["id"], "name": course_name,
                "code": course_code,
            })
            continue
        assignment_includes = ["submission"] if role == "student" else ["all_dates"]
        assignments = client.get_all(f"api/v1/courses/{course['id']}/assignments", {
            "include[]": assignment_includes, "order_by": "due_at", "per_page": 100,
        })
        upcoming = []
        for assignment in assignments:
            schedules = assignment_schedules(
                assignment, now, cutoff, include_all_dates=role == "teacher",
            )
            if not schedules:
                continue
            due_dates = sorted({schedule["due_at"] for schedule in schedules})
            submission = assignment.get("submission") or {}
            published = assignment.get("published")
            upcoming.append({
                "id": assignment.get("id"),
                "name": sanitize_text(assignment.get("name"), "Untitled"),
                "due_at": due_dates[0],
                "due_dates": due_dates,
                "availability_schedules": schedules,
                "submitted": role == "student" and submission.get("submitted_at") is not None,
                "published": published if isinstance(published, bool) else None,
                "locked_for_user": role == "student" and assignment.get("locked_for_user") is True,
                "unlock_at": iso_time(assignment.get("unlock_at")),
                "lock_at": iso_time(assignment.get("lock_at")),
                "html_url": validated_canvas_web_url(
                    client.base_url, assignment.get("html_url"),
                ),
            })
        upcoming.sort(key=lambda item: item["due_at"])
        announcements = collect_announcements(client, course["id"])
        conversations = collect_conversations(client, course["id"])
        discussions = collect_discussions(client, course["id"])
        current_score = enrollment.get("computed_current_score") if enrollment else None
        current_grade = enrollment.get("computed_current_grade") if enrollment else None
        current_grade = (
            sanitize_text(current_grade) or None if role == "student" else None
        )
        needs_grading = course.get("needs_grading_count", 0)
        if not isinstance(needs_grading, int) or isinstance(needs_grading, bool):
            needs_grading = 0
        result_courses.append({
            "id": course["id"], "name": course_name,
            "code": course_code,
            "html_url": canvas_course_web_url(client.base_url, course["id"]),
            "workflow_state": sanitize_text(course.get("workflow_state")) or None,
            "current_score": current_score if role == "student" else None,
            "current_grade": current_grade,
            "needs_grading_count": needs_grading if role == "teacher" else 0,
            "assignments": upcoming,
            "announcements": announcements,
            "conversations": conversations,
            "discussions": discussions,
        })
    result_courses.sort(key=lambda item: item["name"].lower())
    hidden_courses.sort(key=lambda item: item["name"].lower())
    return {
        "available": bool(result_courses or hidden_courses),
        "error": "",
        "courses": result_courses,
        "hidden_courses": hidden_courses,
    }


def collect(
    client: CanvasClient,
    days: int = 14,
    now: datetime | None = None,
    hidden_course_ids: set[str] | None = None,
) -> dict[str, Any]:
    now = now or datetime.now(timezone.utc)
    roles = {}
    for role in ("student", "teacher"):
        try:
            roles[role] = collect_role(
                client, role, days, now, hidden_course_ids,
            )
        except CanvasPermissionError as error:
            roles[role] = empty_role_payload(str(error))
    return {
        "schema_version": PAYLOAD_VERSION,
        "fetched_at": now.isoformat(),
        "days": days,
        "roles": roles,
    }


def print_terminal(data: dict[str, Any]) -> None:
    print(f"Canvas — assignments due in the next {data['days']} days")
    for role, heading in (("student", "Student"), ("teacher", "Teaching")):
        role_data = data["roles"][role]
        print(f"\n{heading}")
        if role_data["error"]:
            print(f"  {role_data['error']}")
            continue
        if not role_data["courses"]:
            print("  No active courses found.")
            continue
        for course in role_data["courses"]:
            if role == "student":
                detail = course["current_grade"] or (
                    f"{course['current_score']:.1f}%"
                    if isinstance(course["current_score"], (int, float)) else "—"
                )
            else:
                detail = f"{course['needs_grading_count']} need grading"
            print(f"\n{course['name']} ({detail})")
            for assignment in course["assignments"]:
                if role == "student":
                    status = "submitted" if assignment["submitted"] else "TODO"
                else:
                    status = (
                        "published" if assignment["published"] is True
                        else "draft" if assignment["published"] is False
                        else "unknown"
                    )
                print(f"  [{status:9}] {assignment['due_at'][:10]}  {assignment['name']}")
            for announcement in (course.get("announcements") or [])[:RECENT_ITEM_LIMIT]:
                posted = (announcement.get("posted_at") or "")[:10] or "no date"
                print(f"  [announce ] {posted}  {announcement.get('title', 'Untitled announcement')}")
            unread = [c for c in course.get("conversations") or [] if c.get("unread")]
            for conversation in unread[:RECENT_ITEM_LIMIT]:
                sent = (conversation.get("last_message_at") or "")[:10] or "no date"
                print(f"  [unread   ] {sent}  {conversation.get('subject', 'No subject')}")
            for discussion in (course.get("discussions") or [])[:RECENT_ITEM_LIMIT]:
                active = (discussion.get("last_activity_at") or "")[:10] or "no date"
                print(f"  [discuss  ] {active}  {discussion.get('title', 'Untitled discussion')}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "command",
        choices=[
            "fetch", "login", "clear-session", "set-token", "clear-token",
            "hide-course", "unhide-course",
        ],
    )
    parser.add_argument("course_id", nargs="?")
    parser.add_argument("--days", type=int, default=14)
    parser.add_argument("--json", action="store_true", dest="as_json")
    parser.add_argument(
        "--token-from-env", action="store_true",
        help="read CANVAS_API_KEY instead of the URL-scoped system keyring",
    )
    parser.add_argument(
        "--browser", default="",
        help="Chromium-family browser executable to use for login",
    )
    parser.add_argument(
        "--login-timeout", type=int, default=DEFAULT_LOGIN_TIMEOUT_SECONDS,
        help="seconds to wait for browser login (30-900; default: 300)",
    )
    parser.add_argument("--course-name", default="")
    parser.add_argument("--course-code", default="")
    parser.add_argument(
        "--base-url", default="",
        help=(
            "Canvas installation URL; defaults to CANVAS_BASE_URL or the "
            "configured Omarchy bar setting"
        ),
    )
    args = parser.parse_args()
    try:
        base_url = resolve_base_url(args.base_url)
        if args.command == "set-token":
            save_token(base_url, getpass.getpass(f"Canvas API token for {base_url}: "))
            print(f"Canvas token saved in the system keyring for {base_url}.")
            return 0
        if args.command == "login":
            if not secret_tool_path():
                raise RuntimeError(
                    "secret-tool is required to save a browser session; install libsecret"
                )
            print(
                f"Opening a private browser window for {base_url}.\n"
                "Complete the Canvas login there; the window will close automatically."
            )
            session = browser_login(base_url, args.browser, args.login_timeout)
            save_browser_session(base_url, session.value, session.base_url)
            print(
                "Canvas browser session saved in the system keyring for "
                f"{session.base_url}."
            )
            if session.base_url != base_url:
                print(
                    f"Canvas redirected {base_url} to its API origin at "
                    f"{session.base_url}; the saved login will use that origin."
                )
            return 0
        if args.command == "clear-session":
            clear_browser_session(base_url)
            print(f"Canvas browser session removed from the system keyring for {base_url}.")
            return 0
        if args.command == "clear-token":
            clear_token(base_url)
            print(f"Canvas token removed from the system keyring for {base_url}.")
            return 0
        if args.command in {"hide-course", "unhide-course"}:
            if not args.course_id:
                raise RuntimeError("A course ID is required")
            hidden = args.command == "hide-course"
            set_course_hidden(base_url, args.course_id, hidden, args.course_name, args.course_code)
            print("Course hidden." if hidden else "Course unhidden.")
            return 0
        credential = get_credential(base_url, args.token_from_env)
        if not credential:
            if args.token_from_env:
                raise RuntimeError("CANVAS_API_KEY is empty")
            raise RuntimeError(
                f"No Canvas credential is saved for {base_url}. "
                f"Run 'omakanvas login --base-url {base_url}' or save an API token"
            )
        credential_kind, secret, credential_base_url = credential
        client = (
            CanvasClient(
                credential_base_url,
                browser_session=secret,
                login_base_url=base_url,
            )
            if credential_kind == "browser_session"
            else CanvasClient(credential_base_url, secret)
        )
        hidden_ids = set(hidden_courses_for(base_url))
        data = collect(client, max(1, args.days), hidden_course_ids=hidden_ids)
        if args.as_json:
            print(json.dumps(data, indent=2, ensure_ascii=False))
        else:
            print_terminal(data)
        return 0
    except (RuntimeError, OSError, subprocess.CalledProcessError) as error:
        print(f"omakanvas: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
